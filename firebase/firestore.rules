rules_version = '2';

// Klienci NIE mają bezpośredniego dostępu do Firestore — cały ruch idzie przez
// API (Cloud Functions, Admin SDK omija reguły). Apka mobilna rozmawia wyłącznie
// z Express-em, jak na Railway. Otwarcie czegokolwiek tutaj wymaga świadomej
// decyzji (i wtedy: reguły per-user, nie blanket allow).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
