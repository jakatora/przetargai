# ATRAPY sekretów WYŁĄCZNIE dla emulatora Functions — NIGDY prawdziwe wartości.
#
# Po co ten plik istnieje (incydent testowy 2026-09-29): gdy go brakuje albo wpis
# jest PUSTY, firebase-tools pobiera sekret z Secret Managera produkcji. Tak lokalny
# emulator dostał kiedyś prawdziwe klucze Resend/Stripe/Anthropic.
#
# Każdy defineSecret z index.js musi mieć tu niepustą atrapę — pilnuje tego
# test/srodowiskoLokalne.test.js. W emulatorze config.js i tak wyłącza AI, Stripe,
# e-mail, faktury i push, a most działa tylko jawnie i tylko na localhost.
# Deploy tego pliku nie czyta (produkcja bierze sekrety z Secret Managera).
JWT_SECRET=emulator-lokalny-jwt-atrapa-nie-produkcja
ANTHROPIC_API_KEY=emulator-atrapa-wylaczone
STRIPE_SECRET_KEY=emulator-atrapa-wylaczone
STRIPE_WEBHOOK_SECRET=emulator-atrapa-wylaczone
STRIPE_PRICE_STANDARD=emulator-atrapa-wylaczone
RESEND_API_KEY=emulator-atrapa-wylaczone
FAKTUROWNIA_API_KEY=emulator-atrapa-wylaczone
FAKTUROWNIA_DOMAIN=emulator-atrapa-wylaczone
ADMIN_API_KEY=emulator-admin-key
