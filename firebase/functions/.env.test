# Środowisko dla testów i emulatora. ŻADNYCH prawdziwych sekretów — te żyją
# w Secret Manager (produkcja) i w .env.local (lokalne wywołania z kluczami).
# Puste klucze usług => features.* = false => testy nie dotykają płatnych API.
NODE_ENV=test
JWT_SECRET=testowy-sekret-tylko-do-testow
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
ADMIN_API_KEY=
APP_URL=http://127.0.0.1:5001/przetargai/europe-central2/api
FREE_TIER_DAILY_MATCH_LIMIT=5
MATCH_CONFIDENCE_THRESHOLD=60
AI_RERANK_TOP_N=30
