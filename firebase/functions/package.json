{
  "name": "przetargai-functions",
  "description": "PrzetargAI backend na Cloud Functions v2 (migracja z Railway, plan: plans/MIGRACJA-FIREBASE.md)",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project przetargai --config ../firebase.test.json \"npm run test:raw\"",
    "emulators": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore",
    "test:e2e": "firebase emulators:exec --only functions,firestore --project przetargai --config ../firebase.test.json \"bash ../test-e2e/smoke.sh\"",
    "test:raw": "node --env-file=.env.test --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
