{
  "name": "przetargai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrzetargAI — backend API (monitoring przetargów publicznych BZP)",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning src/db/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning src/db/seed.js",
    "fetch-tenders": "node --disable-warning=ExperimentalWarning src/jobs/fetchTenders.js --once",
    "backup": "node --disable-warning=ExperimentalWarning src/services/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  }
}
