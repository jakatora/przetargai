# === APLIKACJA ===
NODE_ENV=development
PORT=3100
APP_NAME=PrzetargAI
APP_URL=http://localhost:3000
LANDING_URL=https://przetargai.pl

# === AUTH ===
# Wygeneruj 32-bajtowy hex (PowerShell): patrz README. Min. 16 znaków.
JWT_SECRET=
JWT_TTL_DAYS=30

# === ANTHROPIC (AI matching) ===
ANTHROPIC_API_KEY=
AI_MATCH_MODEL=claude-haiku-4-5
AI_BUDGET_SOFT_USD=200
AI_BUDGET_HARD_USD=500

# === STRIPE (tryb TEST) ===
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=

# === FAKTUROWNIA ===
FAKTUROWNIA_API_KEY=
FAKTUROWNIA_DOMAIN=

# === EMAIL (RESEND) ===
RESEND_API_KEY=
EMAIL_FROM=PrzetargAI <noreply@przetargai.pl>
EMAIL_REPLY_TO=support@przetargai.pl

# === MOST FIREBASE → RAILWAY (konta pomostowe) ===
# Domena techniczna kont pomostowych `most.<uid>@<domena>` (musi być TA SAMA co
# MOST_EMAIL_DOMENA w Firebase). Na nią backend nigdy nie wysyła maili (domena nie
# istnieje — twarde odbicia psują reputację nadawcy w Resend).
MOST_EMAIL_DOMENA=most.przetarg-ai.pl
# Rejestracja adresu z tej domeny wymaga nagłówka X-Most-Podpis =
# HMAC-SHA256(JWT_SECRET, email po trim+lowercase) w hex; bez niego 403.
# KOLEJNOŚĆ WDROŻENIA: 1) Firebase zaczyna wysyłać X-Most-Podpis, 2) dopiero potem
# Railway z true. Do czasu wdrożenia Firebase ustaw tu false — inaczej most przestanie
# zakładać konta pomostowe (nowi użytkownicy bez modułów /api/przetarg).
MOST_WYMAGAJ_PODPISU=true

# === MONITORING (SENTRY) ===
SENTRY_DSN_BACKEND=

# === BACKUPS (Backblaze B2) ===
B2_ACCOUNT_ID=
B2_APP_KEY=
B2_BUCKET=przetargai-backups
BACKUP_ENCRYPTION_KEY=

# === ADMIN ===
ADMIN_API_KEY=

# === DEPLOY ===
RAILWAY_TOKEN=

# === BZP (publiczne API e-Zamówienia) ===
BZP_API_BASE_URL=https://ezamowienia.gov.pl/mo-board/api/v1
BZP_SEARCH_PATH=/notice
BZP_NOTICE_TYPE=ContractNotice
BZP_LOOKBACK_DAYS=7

# === BAZA DANYCH ===
DATABASE_PATH=./data/data.db

# === KOPIE ZAPASOWE ===
# BACKUP_DIR puste => katalog „backups" obok pliku bazy
BACKUP_DIR=
BACKUP_CRON=0 3 * * *
# Ile kopii trzymać na wolumenie (domyślnie 7; 14 nie mieściło się na 500 MB).
# Szanuje go także prestart (scripts/prestart-cleanup.js) — głębiej przycina tylko
# przy realnym braku miejsca i nigdy nie kasuje ostatniej kopii.
BACKUP_RETENTION=7

# === PLIKI UŻYTKOWNIKÓW (Sejf dokumentów, Czarna skrzynka) ===
# Puste => katalogi „sejf" i „czarna-skrzynka" OBOK pliku bazy (ten sam trwały wolumen,
# na Railway /data). NIE ustawiaj ścieżek pod /app — ten katalog znika przy każdym deployu.
SEJF_STORAGE_DIR=
CZARNA_SKRZYNKA_STORAGE_DIR=

# === LOGIKA MATCHINGU ===
# LEGACY PrzetargAI na Railway (decyzja D-031): pobieranie BZP + matching AI + push
# dublują Firebase. false (domyślnie) = scheduler NIE rejestruje tender-fetch, a
# rejestracja/zmiana profilu nie odpala backfillu. Monitory modułów mostu (sejf, SWZ,
# podprogowy, dostępność platformy, waloryzacja) i backup działają niezależnie.
LEGACY_PRZETARG_ENABLED=false
# Codzienne pobieranie przetargów o 12:00 czasu polskiego (patrz SCHEDULER_TZ).
# Działa tylko przy LEGACY_PRZETARG_ENABLED=true.
TENDER_FETCH_CRON=0 12 * * *
# Strefa całego harmonogramu. Produkcja (Railway) chodzi w UTC — bez tego „12"
# odpaliłoby o 13:00 (zima) / 14:00 (lato) w Polsce.
SCHEDULER_TZ=Europe/Warsaw
MATCH_CONFIDENCE_THRESHOLD=60
# Maks. wywołań AI na usera na przebieg dopasowań — pula kandydatów jest rankowana
# darmową heurystyką, AI ocenia tylko czołówkę (kontrola kosztów).
AI_RERANK_TOP_N=30
FREE_TIER_DAILY_MATCH_LIMIT=5
MAGIC_LINK_TTL_MINUTES=10
